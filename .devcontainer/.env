# Disposable local defaults only. Never put deployment credentials in this file.
# Compose interpolates these values into explicit per-service environment mappings.
# After changes, rebuild the dev container to apply the updated environment variables.
POSTGRES_DB=postgres
POSTGRES_USER=rls
POSTGRES_PASSWORD=rls_dev
RLS_DEV_DATABASE=rls_dev
RLS_TEST_DATABASE=rls_test

ASPNETCORE_ENVIRONMENT=Development
PGHOST=postgres
PGPORT=5432
API_HTTP_URL=http://localhost:5294
API_HTTPS_URL=https://localhost:7012
UI_HTTP_URL=http://localhost:5133
UI_HTTPS_URL=https://localhost:7093
API_PROJECT_FILE=DialDen.RLS.API.Root.csproj
UI_PROJECT_FILE=DialDen.RLS.UI.Root.csproj

# Tests host both API and UI in the test process by default.
TEST_HOSTING_MODE=InProcess