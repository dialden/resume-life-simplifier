{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "API",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build api",
            "program": "${workspaceFolder}/src/system/API/DialDen.RLS.API.Root/bin/Debug/net10.0/DialDen.RLS.API.Root.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5294"
            }
        },
        {
            "name": "UI",
            "type": "blazorwasm",
            "request": "launch",
            "cwd": "${workspaceFolder}/src/system/UI/DialDen.RLS.UI.Root",
            "preLaunchTask": "build ui",
            "url": "http://localhost:5133",
            "browser": "edge"
        }
    ],
    "compounds": [
        {
            "name": "API + UI",
            "configurations": [
                "API",
                "UI"
            ],
            "stopAll": true
        }
    ]
}