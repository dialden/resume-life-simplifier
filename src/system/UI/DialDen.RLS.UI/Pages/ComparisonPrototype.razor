@page "/comparison-prototype"
@inherits LocalizedComponentBase
@inject IStringLocalizer<Messages> Localizer

<PageTitle>@Localizer["Comparison_PageTitle"]</PageTitle>

<div class="page-heading comparison-heading">
    <div>
        <p class="eyebrow">@Localizer["Comparison_Eyebrow"]</p>
        <h1>@Localizer[_showMatrix ? "Comparison_MatrixTitle" : "Comparison_Title"]</h1>
        <p class="page-description">@Localizer["Comparison_Job"]</p>
    </div>
    <span class="page-tag">@Localizer["Comparison_DemoTag"]</span>
</div>

<MudAlert Severity="Severity.Info" Class="comparison-notice">
    @Localizer["Comparison_DemoNotice"]
</MudAlert>

@if (!_showMatrix)
{
    <div class="comparison-intro">
        <div>
            <h2>@Localizer["Comparison_TriageHeading"]</h2>
            <p>@Localizer["Comparison_TriageDescription"]</p>
        </div>
        <div class="comparison-actions">
            <span role="status">@Localizer["Comparison_Selected", SelectedCount]</span>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       EndIcon="@Icons.Material.Outlined.ArrowForward" Disabled="@(SelectedCount < 2)"
                       OnClick="@(() => _showMatrix = true)">
                @Localizer["Comparison_Compare"]
            </MudButton>
        </div>
    </div>
    <p class="comparison-selection-help">@Localizer["Comparison_SelectionHelp"]</p>

    @foreach (var tier in new[] { Tier.Qualified, Tier.Verify, Tier.Disqualified })
    {
        var candidates = CandidatesIn(tier).ToArray();
        <section class="surface-panel comparison-tier" aria-labelledby="@($"tier-{tier}")">
            @if (tier == Tier.Disqualified)
            {
                <details>
                    <summary class="comparison-tier-header">
                        <span class="comparison-tier-title">
                            <span class="comparison-tier-icon comparison-tier-icon--missing"><MudIcon Icon="@Icons.Material.Outlined.Block" /></span>
                            <span><strong id="@($"tier-{tier}")">@Localizer["Comparison_Disqualified"]</strong><small>@Localizer["Comparison_DisqualifiedHelp"]</small></span>
                            <span class="count-badge">@candidates.Length</span>
                        </span>
                        <MudIcon Icon="@Icons.Material.Outlined.ExpandMore" />
                    </summary>
                    @CandidateRows(candidates)
                </details>
            }
            else
            {
                <div class="comparison-tier-header">
                    <span class="comparison-tier-title">
                        <span class="comparison-tier-icon @(tier == Tier.Qualified ? "comparison-tier-icon--met" : "comparison-tier-icon--verify")">
                            <MudIcon Icon="@(tier == Tier.Qualified ? Icons.Material.Outlined.CheckCircle : Icons.Material.Outlined.WarningAmber)" />
                        </span>
                        <span>
                            <strong id="@($"tier-{tier}")">@Localizer[tier == Tier.Qualified ? "Comparison_Qualified" : "Comparison_VerifyTier"]</strong>
                            <small>@Localizer[tier == Tier.Qualified ? "Comparison_QualifiedHelp" : "Comparison_VerifyHelp"]</small>
                        </span>
                        <span class="count-badge">@candidates.Length</span>
                    </span>
                </div>
                @CandidateRows(candidates)
            }
        </section>
    }
}
else
{
    <div class="comparison-matrix-toolbar">
        <div>
            <h2>@Localizer["Comparison_MatrixHeading"]</h2>
            <p>@Localizer["Comparison_MatrixHelp"]</p>
        </div>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.ArrowBack" OnClick="@(() => _showMatrix = false)">
            @Localizer["Comparison_Back"]
        </MudButton>
    </div>
    <div class="comparison-table-scroll" role="region" aria-label="@Localizer["Comparison_MatrixHeading"]" tabindex="0">
        <table class="comparison-table">
            <thead>
                <tr>
                    <th scope="col">@Localizer["Comparison_Criteria"]</th>
                    @foreach (var candidate in SelectedCandidates)
                    {
                        <th scope="col">
                            <span class="comparison-column-name">@candidate.Name</span>
                            <span class="comparison-column-caption">@Localizer["Comparison_SampleCandidate"]</span>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @for (var index = 0; index < Criteria.Length; index++)
                {
                    var criterionIndex = index;
                    var criterion = Criteria[index];
                    <tr>
                        <th scope="row">
                            <span class="comparison-criterion-kind">@Localizer[criterion.Mandatory ? "Comparison_Mandatory" : "Comparison_Bonus"]</span>
                            <span class="comparison-criterion-title">@Localizer[criterion.NameKey]</span>
                        </th>
                        @foreach (var candidate in SelectedCandidates)
                        {
                            var assessment = candidate.Assessments[criterionIndex];
                            <td>
                                <details class="comparison-evidence">
                                    <summary>
                                        <span class="comparison-verdict @VerdictClass(assessment)">
                                            <MudIcon Icon="@VerdictIcon(assessment)" Size="Size.Small" />
                                            @Localizer[VerdictKey(assessment)]
                                        </span>
                                        <span class="comparison-evidence-link">@Localizer["Comparison_ViewEvidence"]</span>
                                    </summary>
                                    <div class="comparison-evidence-body">
                                        @if (assessment.Overridden)
                                        {
                                            <p class="comparison-override-label">@Localizer["Comparison_Overridden"]</p>
                                        }
                                        <p class="comparison-evidence-label">@Localizer["Comparison_OriginalConfidence", assessment.Confidence.ToString("P0")]</p>
                                        <blockquote>@Localizer[EvidenceKey(criterion, assessment)]</blockquote>
                                        @if (criterionIndex == 0 || criterionIndex == 2)
                                        {
                                            <p class="comparison-normalized">@Localizer[NormalizedKey(criterionIndex, assessment)]</p>
                                        }
                                        <MudTextField T="string" Label="@Localizer["Comparison_NoteLabel", candidate.Name, Localizer[criterion.NameKey]]"
                                                      Variant="Variant.Outlined" Lines="2" Immediate="true"
                                                      @bind-Value="assessment.Note" />
                                        <div class="comparison-override-actions">
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                                       Disabled="@(assessment.OverrideMet == true)"
                                                       OnClick="@(() => Override(assessment, true))">
                                                @Localizer["Comparison_MarkMet"]
                                            </MudButton>
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                                       Disabled="@(assessment.OverrideMet == false)"
                                                       OnClick="@(() => Override(assessment, false))">
                                                @Localizer["Comparison_MarkNotMet"]
                                            </MudButton>
                                            @if (assessment.Overridden)
                                            {
                                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => Reset(assessment))">
                                                    @Localizer["Comparison_ResetVerdict"]
                                                </MudButton>
                                            }
                                        </div>
                                    </div>
                                </details>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="comparison-scroll-hint">@Localizer["Comparison_ScrollHint"]</p>
}

@code {
    private enum Tier { Qualified, Verify, Disqualified }

    private sealed record Criterion(string NameKey, string EvidencePrefix, bool Mandatory);

    private sealed class Assessment(bool met, double confidence)
    {
        public bool OriginalMet { get; } = met;
        public double Confidence { get; } = confidence;
        public bool? OverrideMet { get; set; }
        public string Note { get; set; } = string.Empty;
        public bool Met => OverrideMet ?? OriginalMet;
        public bool Overridden => OverrideMet.HasValue;
        public bool NeedsVerification => !Overridden && Confidence < 0.85;
    }

    private sealed record Candidate(string Name, Assessment[] Assessments)
    {
        public bool Selected { get; set; }
    }

    private static readonly Criterion[] Criteria =
    [
        new("Comparison_CriterionExperience", "Comparison_EvidenceExperience", true),
        new("Comparison_CriterionApi", "Comparison_EvidenceApi", true),
        new("Comparison_CriterionEducation", "Comparison_EvidenceEducation", true),
        new("Comparison_CriterionFrench", "Comparison_EvidenceFrench", true),
        new("Comparison_CriterionCloud", "Comparison_EvidenceCloud", false),
        new("Comparison_CriterionDelivery", "Comparison_EvidenceDelivery", false),
        new("Comparison_CriterionMentoring", "Comparison_EvidenceMentoring", false)
    ];

    private readonly Candidate[] _candidates =
    [
        new("Alex Tremblay", [new(true, .97), new(true, .95), new(true, .96), new(true, .94), new(true, .93), new(true, .91), new(true, .94)]),
        new("Samira Roy", [new(true, .94), new(true, .95), new(true, .92), new(true, .97), new(true, .90), new(true, .92), new(false, .96)]),
        new("Jules Nguyen", [new(true, .91), new(true, .93), new(true, .95), new(true, .85), new(true, .94), new(false, .91), new(false, .90)]),
        new("Camille Gagnon", [new(true, .78), new(true, .94), new(true, .93), new(true, .96), new(true, .92), new(true, .91), new(true, .95)]),
        new("Morgan Bouchard", [new(true, .93), new(true, .94), new(true, .79), new(true, .91), new(true, .93), new(false, .90), new(false, .91)]),
        new("Noor Martin", [new(true, .94), new(true, .92), new(false, .95), new(true, .93), new(true, .94), new(true, .92), new(false, .90)])
    ];

    private bool _showMatrix;
    private int SelectedCount => _candidates.Count(candidate => candidate.Selected);
    private IEnumerable<Candidate> SelectedCandidates => _candidates.Where(candidate => candidate.Selected);

    private IEnumerable<Candidate> CandidatesIn(Tier tier) => _candidates
        .Where(candidate => GetTier(candidate) == tier)
        .OrderByDescending(candidate => BonusMet(candidate))
        .ThenBy(candidate => candidate.Name, StringComparer.Ordinal);

    private static Tier GetTier(Candidate candidate)
    {
        var mandatory = candidate.Assessments.Take(4);
        if (mandatory.Any(assessment => !assessment.Met)) return Tier.Disqualified;
        return mandatory.Any(assessment => assessment.NeedsVerification) ? Tier.Verify : Tier.Qualified;
    }

    private static int MandatoryMet(Candidate candidate) => candidate.Assessments.Take(4).Count(assessment => assessment.Met);
    private static int BonusMet(Candidate candidate) => candidate.Assessments.Skip(4).Count(assessment => assessment.Met);
    private static int Flags(Candidate candidate) => candidate.Assessments.Count(assessment => assessment.NeedsVerification);
    private static void Override(Assessment assessment, bool met) => assessment.OverrideMet = met;
    private static void Reset(Assessment assessment) => assessment.OverrideMet = null;
    private static string VerdictKey(Assessment assessment) => !assessment.Met ? "Comparison_NotMet" : assessment.NeedsVerification ? "Comparison_Verify" : "Comparison_Met";
    private static string VerdictClass(Assessment assessment) => !assessment.Met ? "comparison-verdict--missing" : assessment.NeedsVerification ? "comparison-verdict--verify" : "comparison-verdict--met";
    private static string VerdictIcon(Assessment assessment) => !assessment.Met ? Icons.Material.Outlined.Cancel : assessment.NeedsVerification ? Icons.Material.Outlined.WarningAmber : Icons.Material.Outlined.CheckCircle;
    private static string EvidenceKey(Criterion criterion, Assessment assessment) =>
        criterion.EvidencePrefix + (!assessment.OriginalMet ? "Missing" : assessment.Confidence < .85 ? "Verify" : "Met");
    private static string NormalizedKey(int index, Assessment assessment) =>
        (index == 0 ? "Comparison_NormalizedExperience" : "Comparison_NormalizedEducation") +
        (!assessment.OriginalMet ? "Missing" : assessment.Confidence < .85 ? "Verify" : "Met");

    private RenderFragment CandidateRows(Candidate[] candidates) => @<div class="comparison-candidates">
        @if (candidates.Length == 0)
        {
            <p class="comparison-empty">@Localizer["Comparison_EmptyTier"]</p>
        }
        @foreach (var candidate in candidates)
        {
            <article class="comparison-candidate">
                <MudCheckBox T="bool" Value="candidate.Selected" ValueChanged="@((bool selected) => candidate.Selected = selected)"
                             Disabled="@(!candidate.Selected && SelectedCount >= 4)"
                             AriaLabel="@Localizer["Comparison_SelectCandidate", candidate.Name]" />
                <div class="comparison-candidate-name">
                    <strong>@candidate.Name</strong>
                    <span>@Localizer["Comparison_SampleCandidate"]</span>
                </div>
                <div class="comparison-pills">
                    <span class="comparison-pill">@Localizer["Comparison_MandatoryCount", MandatoryMet(candidate), 4]</span>
                    <span class="comparison-pill">@Localizer["Comparison_BonusCount", BonusMet(candidate), 3]</span>
                    @if (Flags(candidate) > 0)
                    {
                        <span class="comparison-pill comparison-pill--verify">@Localizer["Comparison_Flags", Flags(candidate)]</span>
                    }
                    @if (GetTier(candidate) == Tier.Disqualified)
                    {
                        <span class="comparison-missing">@Localizer["Comparison_Missing", string.Join(", ", Criteria.Take(4).Where((_, i) => !candidate.Assessments[i].Met).Select(criterion => Localizer[criterion.NameKey].Value))]</span>
                    }
                </div>
            </article>
        }
    </div>;
}
