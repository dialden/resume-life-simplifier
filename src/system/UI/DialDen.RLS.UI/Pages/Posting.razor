@page "/postings/{Id:int}"
@inherits DialDen.RLS.UI.Language.LocalizedComponentBase
@using System.Globalization
@using System.Net
@using DialDen.RLS.Abstractions.Postings
@using DialDen.RLS.UI.Notifications
@using Microsoft.Extensions.Logging
@implements IAsyncDisposable
@inject HttpClient Api
@inject NotificationService Notifications
@inject ILogger<Posting> Logger
@inject IStringLocalizer<Messages> Localizer

<PageTitle>@Localizer["PageTitle_PostingDetails"]</PageTitle>

<div class="breadcrumb"><a href="/">@Localizer["Navigation_Home"]</a><span aria-hidden="true">/</span><a href="/postings">@Localizer["Navigation_JobPostings"]</a><span aria-hidden="true">/</span><span>@Localizer["Posting_Details"]</span></div>
<div class="page-heading">
    <div>
        <p class="eyebrow">@Localizer["Postings_PanelCaption"]</p>
        <h1>@Localizer["Posting_Title"]</h1>
        <p class="page-description">@Localizer["Posting_Description"]</p>
    </div>
</div>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" role="alert">@_error()</MudAlert>
}
else if (_posting is null)
{
    <div class="state-panel" role="status">
        <MudProgressCircular Indeterminate Size="Size.Small" Color="Color.Primary" />
        <p>@Localizer["Posting_Loading"]</p>
    </div>
}
else
{
    @if (_liveUpdatesUnavailable)
    {
        <MudAlert Severity="Severity.Warning" role="alert" data-testid="live-updates-warning">@Localizer["LiveUpdates_Unavailable"]</MudAlert>
    }
    <section class="surface-panel" aria-label="@Localizer["PageTitle_PostingDetails"]">
        <div class="posting-detail-heading">
            <span class="detail-icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.WorkOutline" Size="Size.Large" /></span>
            <div>
                <span class="eyebrow">@Localizer["Posting_Eyebrow"]</span>
                <h2 class="detail-title">@_posting.Title</h2>
            </div>
        </div>
        <dl class="detail-fields">
            <div>
                <dt>@Localizer["Posting_Id"]</dt>
                <dd>@_posting.Id</dd>
            </div>
            <div>
                <dt>@Localizer["CreatePosting_TitleLabel"]</dt>
                <dd>@_posting.Title</dd>
            </div>
            <div>
                <dt>@Localizer["Posting_Status"]</dt>
                <dd>@Localizer[$"PostingStatus_{_posting.Status}"]</dd>
            </div>
        </dl>
        <h3>@Localizer["CreatePosting_DescriptionLabel"]</h3>
        <p data-testid="posting-description" style="white-space: pre-wrap">@_posting.Description</p>
        @if (_posting.PublicListingUrl is not null)
        {
            <p>
                <a data-testid="public-listing-link-@_posting.Id" href="@_posting.PublicListingUrl"
                   target="_blank" rel="noopener noreferrer">@Localizer["PublicListing_LinkLabel"]</a>
            </p>
        }
        <h3>@Localizer["Posting_JobSitePublications"]</h3>
        @if (_posting.JobSitePublications.Count == 0)
        {
            <p>@Localizer["Posting_NoExternalSites"]</p>
        }
        else
        {
            <ul aria-label="@Localizer["Posting_JobSitePublications"]">
                @foreach (var publication in _posting.JobSitePublications)
                {
                    <li data-job-site-id="@publication.JobSiteId">
                        <span>@publication.JobSiteId</span>:
                        <span data-testid="job-site-publication-status">@Localizer[$"PublicationStatus_{publication.Status}"]</span>
                    </li>
                }
            </ul>
            <p>@Localizer["Posting_ExternalPublicationNotice"]</p>
        }
        <div class="panel-footer">@Localizer["Posting_PanelFooter"]</div>
    </section>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private ViewPostingResponse? _posting;
    private Func<string>? _error;
    private bool _liveUpdatesUnavailable;
    private CancellationTokenSource? _viewCancellation;
    private Task? _observation;
    private bool _disposed;

    protected override async Task OnParametersSetAsync()
    {
        await StopObserving();
        if (_disposed)
        {
            return;
        }

        var cancellation = new CancellationTokenSource();
        _viewCancellation = cancellation;
        var token = cancellation.Token;
        _posting = null;
        _error = null;
        _liveUpdatesUnavailable = false;

        try
        {
            var entryPoint = await Api.GetFromJsonAsync<RLSEntryPoint>("/", token)
                ?? throw new System.Text.Json.JsonException("The API returned no entry point.");
            var viewLink = entryPoint.Links.SingleOrDefault(
                link => link is { Rel: "view-posting", Method: "GET" });
            if (viewLink is null)
            {
                _error = () => Localizer["Error_ApiActionUnavailable_PostingDetails"];
                return;
            }

            var href = viewLink.Href.Replace("{id}", Id.ToString(CultureInfo.InvariantCulture));
            using var response = await Api.GetAsync(href, token);
            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                _error = () => Localizer["Error_PostingNotFound"];
                return;
            }

            response.EnsureSuccessStatusCode();
            var posting = await response.Content.ReadFromJsonAsync<ViewPostingResponse>(
                ApiJsonSerializerOptions.Default, token)
                ?? throw new System.Text.Json.JsonException("The API returned no posting.");
            token.ThrowIfCancellationRequested();
            _posting = posting;

            _observation = Observe(href, token);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // Navigation or disposal cancels this page's requests.
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            if (!token.IsCancellationRequested)
            {
                _error = () => Localizer["Error_LoadPosting", ex.Message];
            }
        }
    }

    private async Task Observe(string postingHref, CancellationToken token)
    {
        using var subscription = Notifications.Subscribe();
        try
        {
            await foreach (var signal in subscription.Signals.ReadAllAsync(token))
            {
                switch (signal)
                {
                    case NotificationSignal.Unavailable:
                        await InvokeAsync(() =>
                        {
                            if (!token.IsCancellationRequested)
                            {
                                _liveUpdatesUnavailable = true;
                                StateHasChanged();
                            }
                        });
                        break;

                    case NotificationSignal.Ready:
                    case NotificationSignal.Changed:
                        var refreshed = await Api.GetFromJsonAsync<ViewPostingResponse>(
                            postingHref, ApiJsonSerializerOptions.Default, token)
                            ?? throw new System.Text.Json.JsonException("The API returned no posting.");

                        await InvokeAsync(() =>
                        {
                            if (!token.IsCancellationRequested)
                            {
                                _posting = refreshed;
                                StateHasChanged();
                            }
                        });
                        break;
                }
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // Navigation or disposal ends the observation.
        }
        catch (Exception ex) when (ex is HttpRequestException or IOException
            or System.Text.Json.JsonException or InvalidOperationException or OperationCanceledException)
        {
            Logger.LogWarning(ex, "Live posting updates stopped.");
            await InvokeAsync(() =>
            {
                if (!token.IsCancellationRequested)
                {
                    _liveUpdatesUnavailable = true;
                    StateHasChanged();
                }
            });
        }
        catch (Exception ex)
        {
            await DispatchExceptionAsync(ex);
        }
    }

    private async Task StopObserving()
    {
        var cancellation = _viewCancellation;
        var observation = _observation;
        _viewCancellation = null;
        _observation = null;
        if (cancellation is null)
        {
            return;
        }

        cancellation.Cancel();
        try
        {
            if (observation is not null)
            {
                await observation;
            }
        }
        finally
        {
            cancellation.Dispose();
        }
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();
        _disposed = true;
        await StopObserving();
    }
}
