@page "/postings/{Id:int}"
@using System.Globalization
@using System.Net
@using DialDen.RLS.Abstractions.Postings
@inject HttpClient Api

<PageTitle>@RLSLocalizer["PostingDetails_Title"] | Resume Life Simplifier</PageTitle>

<div class="breadcrumb"><a href="/">@RLSLocalizer["Nav_Home"]</a><span aria-hidden="true">/</span><a href="/postings">@RLSLocalizer["Nav_ViewPostings"]</a><span aria-hidden="true">/</span><span>@RLSLocalizer["PostingDetails_Breadcrumb"]</span></div>
<div class="page-heading">
    <div>
        <p class="eyebrow">@RLSLocalizer["PostingDetails_Eyebrow"]</p>
        <h1>@RLSLocalizer["PostingDetails_Title"]</h1>
        <p class="page-description">@RLSLocalizer["PostingDetails_Description"]</p>
    </div>
</div>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" role="alert">@_error</MudAlert>
}
else if (_posting is null)
{
    <div class="state-panel" role="status">
        <MudProgressCircular Indeterminate Size="Size.Small" Color="Color.Primary" />
        <p>@RLSLocalizer["PostingDetails_Loading"]</p>
    </div>
}
else
{
    <section class="surface-panel" aria-label="@RLSLocalizer["PostingDetails_Title"]">
        <div class="posting-detail-heading">
            <span class="detail-icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.WorkOutline" Size="Size.Large" /></span>
            <div>
                <span class="eyebrow">@RLSLocalizer["PostingDetails_PostingEyebrow"]</span>
                <h2 class="detail-title">@_posting.Title</h2>
            </div>
        </div>
        <dl class="detail-fields">
            <div>
                <dt>@RLSLocalizer["PostingDetails_PostingId"]</dt>
                <dd>@_posting.Id</dd>
            </div>
            <div>
                <dt>@RLSLocalizer["Common_Title"]</dt>
                <dd>@_posting.Title</dd>
            </div>
            <div>
                <dt>@RLSLocalizer["Common_Status"]</dt>
                <dd>@RLSLocalizer.Translate("PostingStatus", _posting.Status.ToString())</dd>
            </div>
        </dl>
        <h3>@RLSLocalizer["Common_Description"]</h3>
        <p data-testid="posting-description" style="white-space: pre-wrap">@_posting.Description</p>
        <h3>@RLSLocalizer["Common_PostingPublications"]</h3>
        @if (_posting.JobSitePublications.Count == 0)
        {
            <p>@RLSLocalizer["PostingDetails_NoJobSites"]</p>
        }
        else
        {
            <ul aria-label="@RLSLocalizer["Common_PostingPublications"]">
                @foreach (var publication in _posting.JobSitePublications)
                {
                    <li data-job-site-id="@publication.JobSiteId">
                        <span>@publication.JobSiteId</span>:
                        <span data-testid="job-site-publication-status">@RLSLocalizer.Translate("PublicationStatus", publication.Status.ToString())</span>
                    </li>
                }
            </ul>
            <p>@RLSLocalizer["PostingDetails_AsynchronousNotice"]</p>
        }
        <div class="panel-footer">@RLSLocalizer["PostingDetails_Footer"]</div>
    </section>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private ViewPostingResponse? _posting;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        _posting = null;
        _error = null;

        try
        {
            var entryPoint = await Api.GetFromJsonAsync<RLSEntryPoint>("/")
                ?? throw new System.Text.Json.JsonException(RLSLocalizer["Api_NoEntryPoint"].Value);
            var viewLink = entryPoint.Links.SingleOrDefault(
                link => link is { Rel: "view-posting", Method: "GET" });
            if (viewLink is null)
            {
                _error = RLSLocalizer["PostingDetails_NotOffered"].Value;
                return;
            }

            var href = viewLink.Href.Replace("{id}", Id.ToString(CultureInfo.InvariantCulture));
            using var response = await Api.GetAsync(href);
            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                _error = RLSLocalizer["PostingDetails_NotFound"].Value;
                return;
            }

            response.EnsureSuccessStatusCode();
            _posting = await response.Content.ReadFromJsonAsync<ViewPostingResponse>(
                ApiJsonSerializerOptions.Default)
                ?? throw new System.Text.Json.JsonException(RLSLocalizer["Api_NoPosting"].Value);
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            _error = RLSLocalizer["PostingDetails_LoadFailed", ex.Message].Value;
        }
    }
}
