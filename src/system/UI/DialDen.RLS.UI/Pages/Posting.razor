@page "/postings/{Id:int}"
@using System.Globalization
@using System.Net
@using DialDen.RLS.Abstractions.Postings
@inject HttpClient Api

<PageTitle>Posting details | Resume Life Simplifier</PageTitle>

<div class="breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/postings">View postings</a><span aria-hidden="true">/</span><span>Details</span></div>
<div class="page-heading">
    <div>
        <p class="eyebrow">YOUR OPPORTUNITY LIBRARY</p>
        <h1>Posting details</h1>
        <p class="page-description">A closer look at your opportunity.</p>
    </div>
</div>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" role="alert">@_error</MudAlert>
}
else if (_posting is null)
{
    <div class="state-panel" role="status">
        <MudProgressCircular Indeterminate Size="Size.Small" Color="Color.Primary" />
        <p>Loading posting details...</p>
    </div>
}
else
{
    <section class="surface-panel" aria-label="Posting details">
        <div class="posting-detail-heading">
            <span class="detail-icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.WorkOutline" Size="Size.Large" /></span>
            <div>
                <span class="eyebrow">JOB POSTING</span>
                <h2 class="detail-title">@_posting.Title</h2>
            </div>
        </div>
        <dl class="detail-fields">
            <div>
                <dt>Posting ID</dt>
                <dd>@_posting.Id</dd>
            </div>
            <div>
                <dt>Title</dt>
                <dd>@_posting.Title</dd>
            </div>
            <div>
                <dt>Status</dt>
                <dd>@_posting.Status</dd>
            </div>
        </dl>
        <div class="panel-footer">Part of your personal opportunity library</div>
    </section>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private ViewPostingResponse? _posting;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        _posting = null;
        _error = null;

        try
        {
            var entryPoint = await Api.GetFromJsonAsync<RLSEntryPoint>("/")
                ?? throw new System.Text.Json.JsonException("The API returned no entry point.");
            var viewLink = entryPoint.Links.SingleOrDefault(
                link => link is { Rel: "view-posting", Method: "GET" });
            if (viewLink is null)
            {
                _error = "The RLS API does not currently offer posting details.";
                return;
            }

            var href = viewLink.Href.Replace("{id}", Id.ToString(CultureInfo.InvariantCulture));
            using var response = await Api.GetAsync(href);
            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                _error = "Posting not found.";
                return;
            }

            response.EnsureSuccessStatusCode();
            _posting = await response.Content.ReadFromJsonAsync<ViewPostingResponse>(
                ApiJsonSerializerOptions.Default)
                ?? throw new System.Text.Json.JsonException("The API returned no posting.");
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            _error = $"Could not load the posting: {ex.Message}";
        }
    }
}
