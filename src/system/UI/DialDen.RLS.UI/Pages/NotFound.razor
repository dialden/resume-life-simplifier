@page "/not-found"
@inherits DialDen.RLS.UI.Language.LocalizedComponentBase
@layout MainLayout

@inject IStringLocalizer<Messages> Localizer

<PageTitle>@Localizer["PageTitle_NotFound"]</PageTitle>

<section class="surface-panel empty-state">
    <span class="empty-icon"><MudIcon Icon="@Icons.Material.Outlined.SearchOff" Size="Size.Large" /></span>
    <p class="eyebrow">404</p>
    <h1>@Localizer["NotFound_Title"]</h1>
    <p>@Localizer["NotFound_Description"]</p>
    <a class="action-link action-primary" href="/">@Localizer["NotFound_BackToOverview"]</a>
</section>