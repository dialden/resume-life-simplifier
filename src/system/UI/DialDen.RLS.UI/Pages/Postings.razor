@page "/postings"
@inherits DialDen.RLS.UI.Language.LocalizedComponentBase
@using DialDen.RLS.Abstractions.Postings
@using System.Globalization
@using DialDen.RLS.UI.Notifications
@using Microsoft.Extensions.Logging
@implements IAsyncDisposable
@inject HttpClient Api
@inject NotificationService Notifications
@inject ILogger<Postings> Logger
@inject IStringLocalizer<Messages> Localizer

<PageTitle>@Localizer["PageTitle_JobPostings"]</PageTitle>

<div class="breadcrumb"><a href="/">@Localizer["Navigation_Home"]</a><span aria-hidden="true">/</span><span>@Localizer["Navigation_JobPostings"]</span></div>
<div class="page-heading">
    <div>
        <p class="eyebrow">@Localizer["Postings_Eyebrow"]</p>
        <h1>@Localizer["Navigation_JobPostings"]</h1>
        <p class="page-description">@Localizer["Postings_Description"]</p>
    </div>
    <a class="action-link action-primary" href="/postings/create">
        <MudIcon Icon="@Icons.Material.Outlined.Add" />@Localizer["CreatePosting_Title"]
    </a>
</div>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" role="alert">@_error()</MudAlert>
}
else if (_page is null)
{
    <div class="state-panel" role="status">
        <MudProgressCircular Indeterminate Size="Size.Small" Color="Color.Primary" />
        <p>@Localizer["Postings_Loading"]</p>
    </div>
}
else
{
    @if (_liveUpdatesUnavailable)
    {
        <MudAlert Severity="Severity.Warning" role="alert" data-testid="live-updates-warning">@Localizer["LiveUpdates_Unavailable"]</MudAlert>
    }
    <section class="surface-panel" aria-labelledby="postings-heading">
        <div class="panel-header">
            <div class="panel-title">
                <h2 id="postings-heading">@Localizer["Postings_ListTitle"]</h2>
                <span class="count-badge">@_page.TotalCount</span>
            </div>
            <span class="panel-caption">@Localizer["Postings_PanelCaption"]</span>
        </div>
        <div class="posting-list-actions">
            <div class="publishing-submit">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           Disabled="@(!CanPublishSelected || _isPublishing)"
                           OnClick="OpenPublishDialog">
                    @Localizer["Postings_PublishSelected"]
                </MudButton>
                <p class="publishing-help">@Localizer["Postings_SelectDraftHelp"]</p>
            </div>
        </div>
        @if (_page.Items.Count == 0)
        {
            <div class="empty-state" role="status">
                <span class="empty-icon"><MudIcon Icon="@Icons.Material.Outlined.WorkOutline" Size="Size.Large" /></span>
                @if (_page.TotalCount == 0)
                {
                    <h3>@Localizer["Postings_EmptyTitle"]</h3>
                    <p>@Localizer["Postings_EmptyDescriptionFirstLine"]<br />@Localizer["Postings_EmptyDescriptionSecondLine"]</p>
                }
                else
                {
                    <h3>@Localizer["Postings_EmptyPageTitle"]</h3>
                    <p>@Localizer["Postings_EmptyPageDescription"]</p>
                }
                @if (_page.PageNumber > 1)
                {
                    <a class="action-link action-primary" href="/postings">@Localizer["Postings_BackToFirstPage"]</a>
                }
            </div>
        }
        else
        {
            <div class="list-columns" aria-hidden="true"><span>@Localizer["Postings_SelectColumn"]</span><span>@Localizer["Posting_Status"]</span></div>
            <ul class="posting-list" aria-label="@Localizer["Postings_ListLabel"]">
                @foreach (var posting in _page.Items)
                {
                    <li @key="posting.Id" class="posting-list-item">
                        <label class="posting-selection">
                            <input type="radio" name="selectedPosting" value="@posting.Id"
                                   checked="@(_selectedPostingId == posting.Id)"
                                   aria-label="@Localizer["Postings_SelectPosting", posting.Title, posting.Id]"
                                   @onchange="@(() => _selectedPostingId = posting.Id)" />
                        </label>
                        <a class="posting-row" href="@($"/postings/{posting.Id}")"
                           aria-label="@Localizer["Postings_ViewPosting", posting.Title, posting.Id]">
                            <span class="posting-icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.WorkOutline" /></span>
                            <span class="posting-summary">
                                <span class="posting-name" role="heading" aria-level="3">@posting.Title</span>
                                <span class="posting-reference">@Localizer["Postings_Reference", posting.Id]</span>
                                @if (posting.JobSitePublications.Count > 0)
                                {
                                    <span role="list" aria-label="@Localizer["Posting_JobSitePublications"]">
                                        @foreach (var publication in posting.JobSitePublications)
                                        {
                                            <span role="listitem" data-job-site-id="@publication.JobSiteId">
                                                @publication.JobSiteId:
                                                <span data-testid="job-site-publication-status">@Localizer[$"PublicationStatus_{publication.Status}"]</span>
                                            </span>
                                        }
                                    </span>
                                }
                            </span>
                            <span class="posting-status" data-testid="posting-status-@posting.Id">@Localizer[$"PostingStatus_{posting.Status}"]</span>
                            <span class="row-action" aria-hidden="true">@Localizer["Postings_ViewDetails"]<MudIcon Icon="@Icons.Material.Outlined.ArrowForward" Size="Size.Small" /></span>
                        </a>
                        @if (posting.PublicListingUrl is not null)
                        {
                            <a class="row-action" data-testid="public-listing-link-@posting.Id"
                               href="@posting.PublicListingUrl" target="_blank" rel="noopener noreferrer">
                                @Localizer["PublicListing_LinkLabel"]
                            </a>
                        }
                    </li>
                }
            </ul>
        }
        <div class="panel-footer pagination-footer" data-testid="posting-pagination"
             data-total-count="@_page.TotalCount" data-page-number="@_page.PageNumber" data-page-size="@_page.PageSize">
            <span role="status">@Localizer["Postings_Count", FirstPosting, LastPosting, _page.TotalCount]</span>
            <nav class="pagination-controls" aria-label="@Localizer["Postings_PaginationLabel"]">
                @if (_page.PageNumber > 1)
                {
                    <a class="pagination-link" href="@PageUrl(_page.PageNumber - 1)" aria-label="@Localizer["Pagination_Previous"]">
                        <MudIcon Icon="@Icons.Material.Outlined.ChevronLeft" Size="Size.Small" />@Localizer["Pagination_Previous"]
                    </a>
                }
                else
                {
                    <button class="pagination-link disabled" type="button" aria-label="@Localizer["Pagination_Previous"]" disabled>
                        <MudIcon Icon="@Icons.Material.Outlined.ChevronLeft" Size="Size.Small" />@Localizer["Pagination_Previous"]
                    </button>
                }
                <span class="page-indicator">@Localizer["Pagination_Page", _page.PageNumber, TotalPages]</span>
                @if (_page.PageNumber < TotalPages)
                {
                    <a class="pagination-link" href="@PageUrl(_page.PageNumber + 1)" aria-label="@Localizer["Pagination_Next"]">
                        @Localizer["Pagination_Next"]<MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" />
                    </a>
                }
                else
                {
                    <button class="pagination-link disabled" type="button" aria-label="@Localizer["Pagination_Next"]" disabled>
                        @Localizer["Pagination_Next"]<MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" />
                    </button>
                }
            </nav>
        </div>
    </section>
}

<MudDialog @bind-Visible="_showPublishDialog" Options="_publishDialogOptions">
    <TitleContent>
        <h2>@Localizer["Postings_PublishTitle"]</h2>
    </TitleContent>
    <DialogContent>
        <p class="publishing-posting-title">@_page?.Items.SingleOrDefault(posting => posting.Id == _selectedPostingId)?.Title</p>
        @if (_publishError is not null)
        {
            <MudAlert Severity="Severity.Error" role="alert">@_publishError()</MudAlert>
        }
        <fieldset class="publishing-channels" disabled="@_isPublishing"
                  aria-describedby="publishing-channels-help">
            <legend>@Localizer["Postings_PublishingChannels"]</legend>
            <p id="publishing-channels-help" class="publishing-help">@Localizer["Postings_PublishingChannelsHelp"]</p>
            <div class="publishing-options">
                @foreach (var site in _jobSites)
                {
                    <label class="publishing-option">
                        <input type="checkbox" data-testid="job-site-@site.Id"
                               aria-label="@Localizer["Postings_PublishToSite", site.Name]"
                               checked="@_selectedJobSiteIds.Contains(site.Id)"
                               @onchange="@(args => SelectJobSite(site.Id, args.Value is true))" />
                        <span>@site.Name</span>
                    </label>
                }
            </div>
            <p class="publishing-help">@Localizer["Postings_PublishWithoutExternalSites"]</p>
            <p class="publishing-notice">@Localizer["Postings_PublishingNotice"]</p>
        </fieldset>
    </DialogContent>
    <DialogActions>
        <MudButton Disabled="@_isPublishing" OnClick="CancelPublishDialog">@Localizer["Common_Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@_isPublishing" OnClick="PublishSelected">
            @(_isPublishing ? Localizer["Postings_Publishing"] : Localizer["Postings_ConfirmPublication"])
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [SupplyParameterFromQuery(Name = "page")]
    public string? Page { get; set; }

    private ListPostingsResponse? _page;
    private Func<string>? _error;
    private int _loadVersion;
    private readonly SemaphoreSlim _refreshGate = new(1, 1);
    private CancellationTokenSource? _viewCancellation;
    private Task? _observation;
    private bool _disposed;
    private bool _liveUpdatesUnavailable;
    private int? _selectedPostingId;
    private bool _isPublishing;
    private bool _showPublishDialog;
    private Func<string>? _publishError;
    private readonly DialogOptions _publishDialogOptions = new()
    {
        FullWidth = true,
        MaxWidth = MaxWidth.Small,
        BackdropClick = false,
        CloseOnEscapeKey = false
    };
    private IReadOnlyList<JobSite> _jobSites = [];
    private readonly HashSet<string> _selectedJobSiteIds = new(StringComparer.Ordinal);

    private bool CanPublishSelected => _page?.Items.Any(posting =>
        posting.Id == _selectedPostingId && posting.Status == PostingStatus.Draft) == true;

    private void OpenPublishDialog()
    {
        if (!CanPublishSelected || _isPublishing)
        {
            return;
        }
        _selectedJobSiteIds.Clear();
        _publishError = null;
        _showPublishDialog = true;
    }

    private void CancelPublishDialog()
    {
        _showPublishDialog = false;
        _selectedJobSiteIds.Clear();
        _publishError = null;
    }

    private void SelectJobSite(string id, bool selected)
    {
        if (selected)
        {
            _selectedJobSiteIds.Add(id);
        }
        else
        {
            _selectedJobSiteIds.Remove(id);
        }
    }

    private long TotalPages => _page is null ? 1 : Math.Max(1, _page.TotalCount / _page.PageSize +
        (_page.TotalCount % _page.PageSize == 0 ? 0 : 1));
    private long FirstPosting => _page is null || _page.Items.Count == 0 ? 0 : ((long)_page.PageNumber - 1) * _page.PageSize + 1;
    private long LastPosting => _page is null || _page.Items.Count == 0 ? 0 : FirstPosting + _page.Items.Count - 1;

    private static string PageUrl(int pageNumber) => $"/postings?page={pageNumber.ToString(CultureInfo.InvariantCulture)}";

    protected override async Task OnParametersSetAsync()
    {
        var version = ++_loadVersion;
        await StopObserving();
        if (_disposed || version != _loadVersion)
        {
            return;
        }
        var cancellation = new CancellationTokenSource();
        _viewCancellation = cancellation;
        var token = cancellation.Token;
        _page = null;
        _error = null;
        _liveUpdatesUnavailable = false;
        _selectedPostingId = null;
        _showPublishDialog = false;
        _selectedJobSiteIds.Clear();
        var pageNumber = 1;
        if (Page is not null &&
            (!int.TryParse(Page, NumberStyles.None, CultureInfo.InvariantCulture, out pageNumber) || pageNumber < 1))
        {
            _error = () => Localizer["Postings_InvalidPage"];
            return;
        }

        try
        {
            var entryPoint = await Api.GetFromJsonAsync<RLSEntryPoint>("/", token)
                ?? throw new System.Text.Json.JsonException("The API returned no entry point.");
            if (version != _loadVersion)
            {
                return;
            }
            var listLink = entryPoint.Links.SingleOrDefault(
                link => link is { Rel: "list-postings", Method: "GET" });
            if (listLink is null)
            {
                _error = () => Localizer["Error_ApiActionUnavailable_PostingsList"];
                return;
            }

            var sitesLink = entryPoint.Links.SingleOrDefault(
                link => link is { Rel: "list-job-sites", Method: "GET" });
            if (sitesLink is null)
            {
                _error = () => Localizer["Error_ApiActionUnavailable_JobSites"];
                return;
            }
            var sites = await Api.GetFromJsonAsync<JobSite[]>(sitesLink.Href, token)
                ?? throw new System.Text.Json.JsonException("The API returned no job-site destinations.");

            var separator = listLink.Href.Contains('?') ? '&' : '?';
            var href = $"{listLink.Href}{separator}pageNumber={pageNumber.ToString(CultureInfo.InvariantCulture)}";
            var page = await Api.GetFromJsonAsync<ListPostingsResponse>(
                    href,
                    ApiJsonSerializerOptions.Default, token)
                ?? throw new System.Text.Json.JsonException("The API returned no postings page.");
            if (version == _loadVersion && !token.IsCancellationRequested)
            {
                _page = page;
                _jobSites = sites;
                _observation = Observe(href, version, token);
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // Navigation cancels this page's requests.
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            if (version == _loadVersion)
            {
                _error = () => Localizer["Error_LoadPostings", ex.Message];
            }
        }
    }

    private async Task PublishSelected()
    {
        await _refreshGate.WaitAsync();
        try
        {
            await PublishSelectedCore();
        }
        finally
        {
            _refreshGate.Release();
        }
    }

    private async Task PublishSelectedCore()
    {
        var version = _loadVersion;
        if (_isPublishing || !CanPublishSelected || _selectedPostingId is not { } postingId || _page is null)
        {
            return;
        }

        _isPublishing = true;
        _publishError = null;
        try
        {
            var entryPoint = await Api.GetFromJsonAsync<RLSEntryPoint>("/")
                ?? throw new System.Text.Json.JsonException("The API returned no entry point.");
            var publishLink = entryPoint.Links.SingleOrDefault(
                link => link is { Rel: "publish-posting", Method: "PATCH" });
            if (publishLink is null)
            {
                _publishError = () => Localizer["Error_ApiActionUnavailable_Publish"];
                return;
            }

            var href = publishLink.Href.Replace("{id}", postingId.ToString(CultureInfo.InvariantCulture));
            using var response = await Api.PatchAsJsonAsync(
                href,
                new { Status = PostingStatus.Published, JobSiteIds = _selectedJobSiteIds.ToArray() },
                ApiJsonSerializerOptions.Default);
            if (!response.IsSuccessStatusCode)
            {
                var statusCode = response.StatusCode;
                _publishError = () => statusCode switch
                {
                    System.Net.HttpStatusCode.NotFound => Localizer["Error_PostingNotFound"],
                    System.Net.HttpStatusCode.Conflict => Localizer["Api_PostingAlreadyPublished"],
                    _ => Localizer["Error_PublishPostingHttp", (int)statusCode]
                };
                return;
            }

            var published = await response.Content.ReadFromJsonAsync<PublishPostingResponse>(
                    ApiJsonSerializerOptions.Default)
                ?? throw new System.Text.Json.JsonException("The API returned no published posting.");
            if (_disposed || version != _loadVersion || _page is null)
            {
                return;
            }
            _page = _page with
            {
                Items = _page.Items.Select(posting => posting.Id == published.Id
                    ? posting with
                    {
                        Status = published.Status,
                        PublicListingUrl = published.PublicListingUrl,
                        JobSitePublications = published.JobSitePublications
                    }
                    : posting).ToArray()
            };
            _selectedPostingId = null;
            _selectedJobSiteIds.Clear();
            _showPublishDialog = false;
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            _publishError = () => Localizer["Error_PublishPosting", ex.Message];
        }
        finally
        {
            _isPublishing = false;
        }
    }

    private async Task Observe(string pageHref, int version, CancellationToken token)
    {
        using var subscription = Notifications.Subscribe();
        try
        {
            await foreach (var signal in subscription.Signals.ReadAllAsync(token))
            {
                switch (signal)
                {
                    case NotificationSignal.Unavailable:
                        await InvokeAsync(() =>
                        {
                            if (!token.IsCancellationRequested && version == _loadVersion)
                            {
                                _liveUpdatesUnavailable = true;
                                StateHasChanged();
                            }
                        });
                        break;

                    case NotificationSignal.Ready:
                    case NotificationSignal.Changed:
                        // Serialize refreshes with publishing so an older GET cannot overwrite its result.
                        await _refreshGate.WaitAsync(token);
                        try
                        {
                            var refreshed = await Api.GetFromJsonAsync<ListPostingsResponse>(
                                pageHref, ApiJsonSerializerOptions.Default, token)
                                ?? throw new System.Text.Json.JsonException("The API returned no postings page.");
                            await InvokeAsync(() =>
                            {
                                if (!token.IsCancellationRequested && version == _loadVersion)
                                {
                                    _page = refreshed;
                                    StateHasChanged();
                                }
                            });
                        }
                        finally
                        {
                            _refreshGate.Release();
                        }
                        break;
                }
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // Navigation or disposal ends the observation.
        }
        catch (Exception ex) when (ex is HttpRequestException or IOException
            or System.Text.Json.JsonException or InvalidOperationException or OperationCanceledException)
        {
            Logger.LogWarning(ex, "Live postings updates stopped.");
            await InvokeAsync(() =>
            {
                if (!token.IsCancellationRequested && version == _loadVersion)
                {
                    _liveUpdatesUnavailable = true;
                    StateHasChanged();
                }
            });
        }
        catch (Exception ex)
        {
            await DispatchExceptionAsync(ex);
        }
    }

    private async Task StopObserving()
    {
        var cancellation = _viewCancellation;
        var observation = _observation;
        _viewCancellation = null;
        _observation = null;
        if (cancellation is null)
        {
            return;
        }
        cancellation.Cancel();
        try
        {
            if (observation is not null)
            {
                await observation;
            }
        }
        finally
        {
            cancellation.Dispose();
        }
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();
        _disposed = true;
        ++_loadVersion;
        await StopObserving();
    }
}
