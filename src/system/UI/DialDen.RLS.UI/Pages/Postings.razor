@page "/postings"
@using DialDen.RLS.Abstractions.Postings
@inject HttpClient Api

<PageTitle>Job postings | Resume Life Simplifier</PageTitle>

<div class="breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Job postings</span></div>
<div class="page-heading">
    <div>
        <p class="eyebrow">OPPORTUNITIES, ORGANIZED</p>
        <h1>Job postings</h1>
        <p class="page-description">All your opportunities, in one place.</p>
    </div>
    <a class="action-link action-primary" href="/postings/create">
        <MudIcon Icon="@Icons.Material.Outlined.Add" />Create posting
    </a>
</div>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" role="alert">@_error</MudAlert>
}
else if (_postings is null)
{
    <div class="state-panel" role="status">
        <MudProgressCircular Indeterminate Size="Size.Small" Color="Color.Primary" />
        <p>Loading your postings...</p>
    </div>
}
else
{
    <section class="surface-panel" aria-labelledby="postings-heading">
        <div class="panel-header">
            <div class="panel-title">
                <h2 id="postings-heading">All postings</h2>
                <span class="count-badge">@_postings.Count</span>
            </div>
            <span class="panel-caption">Your opportunity library</span>
        </div>
        @if (_postings.Count == 0)
        {
            <div class="empty-state" role="status">
                <span class="empty-icon"><MudIcon Icon="@Icons.Material.Outlined.WorkOutline" Size="Size.Large" /></span>
                <h3>No postings yet.</h3>
                <p>Your next opportunity belongs here.<br />Choose Create posting to start your collection.</p>
            </div>
        }
        else
        {
            <div class="list-columns" aria-hidden="true"><span>JOB TITLE</span><span>DETAILS</span></div>
            <ul class="posting-list" aria-label="Postings">
                @foreach (var posting in _postings)
                {
                    <li @key="posting.Id">
                        <a class="posting-row" href="@($"/postings/{posting.Id}")">
                            <span class="posting-icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.WorkOutline" /></span>
                            <span class="posting-summary">
                                <span class="posting-name" data-testid="posting-title">@posting.Title</span>
                                <span class="posting-reference">Posting #@posting.Id</span>
                            </span>
                            <span class="row-action" aria-hidden="true">View details<MudIcon Icon="@Icons.Material.Outlined.ArrowForward" Size="Size.Small" /></span>
                        </a>
                    </li>
                }
            </ul>
            <div class="panel-footer">@_postings.Count @(_postings.Count == 1 ? "posting" : "postings") in your workspace</div>
        }
    </section>
}

@code {
    private IReadOnlyList<ViewPostingResponse>? _postings;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var entryPoint = await Api.GetFromJsonAsync<RLSEntryPoint>("/")
                ?? throw new System.Text.Json.JsonException("The API returned no entry point.");
            var listLink = entryPoint.Links.SingleOrDefault(
                link => link is { Rel: "list-postings", Method: "GET" });
            if (listLink is null)
            {
                _error = "The RLS API does not currently offer a postings list.";
                return;
            }

            _postings = await Api.GetFromJsonAsync<ViewPostingResponse[]>(listLink.Href)
                ?? throw new System.Text.Json.JsonException("The API returned no postings list.");
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            _error = $"Could not load postings: {ex.Message}";
        }
    }
}
