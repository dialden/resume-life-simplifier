@page "/"
@inherits DialDen.RLS.UI.Language.LocalizedComponentBase

@inject IStringLocalizer<Messages> Localizer

<PageTitle>@Localizer["PageTitle_Overview"]</PageTitle>

@inject HttpClient Api

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" role="alert">@_error()</MudAlert>
}
else if (_entryPoint is null)
{
    <div class="state-panel" role="status">
        <MudProgressCircular Indeterminate Size="Size.Small" Color="Color.Primary" />
        <p>@Localizer["Home_Loading"]</p>
    </div>
}
else
{
    <div class="page-heading">
        <div>
            <p class="eyebrow">@Localizer["Home_Eyebrow"]</p>
            <h1>@Localizer["Navigation_Overview"]</h1>
            <p class="page-description">@Localizer["Home_Description"]</p>
        </div>
        <span class="page-tag">@Localizer["Layout_PersonalWorkspace"]</span>
    </div>

    <section class="welcome-panel" aria-labelledby="welcome-title">
        <div class="welcome-copy">
            <span class="hero-label">@Localizer["Home_HeroLabel"]</span>
            <h2 id="welcome-title">@Localizer["Home_WelcomeTitleFirstLine"]<br />@Localizer["Home_WelcomeTitleSecondLine"]</h2>
            <p>@Localizer["Home_WelcomeDescription"]</p>
            <ul class="hero-actions" aria-label="@Localizer["Accessibility_AvailableActions"]">
                @foreach (var link in _entryPoint.Links.Where(link => link is { Rel: "list-postings", Method: "GET" }))
                {
                    <li>
                        <a class="action-link action-primary" href="/postings" rel="@link.Rel">
                            @Localizer["Home_ViewPostings"]
                            <MudIcon Icon="@Icons.Material.Outlined.ArrowForward" />
                        </a>
                    </li>
                }
            </ul>
        </div>
        <div class="welcome-art" aria-hidden="true">
            <div class="art-orbit"></div>
            <div class="art-card art-card-back"></div>
            <div class="art-card art-card-front">
                <span class="art-icon"><MudIcon Icon="@Icons.Material.Outlined.WorkOutline" Size="Size.Large" /></span>
                <span class="art-line art-line-long"></span>
                <span class="art-line"></span>
                <span class="art-check"><MudIcon Icon="@Icons.Material.Outlined.Check" /></span>
            </div>
            <span class="art-spark"><MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" /></span>
        </div>
    </section>

    <section class="getting-started" aria-labelledby="getting-started-title">
        <div class="section-heading">
            <h2 id="getting-started-title">@Localizer["Home_GettingStartedTitle"]</h2>
            <p>@Localizer["Home_GettingStartedDescription"]</p>
        </div>
        <div class="feature-grid">
            <article class="feature-card">
                <span class="feature-icon"><MudIcon Icon="@Icons.Material.Outlined.LibraryAdd" /></span>
                <span class="step-number">01</span>
                <h3>@Localizer["Home_StepOneTitle"]</h3>
                <p>@Localizer["Home_StepOneDescription"]</p>
            </article>
            <article class="feature-card">
                <span class="feature-icon feature-icon-blue"><MudIcon Icon="@Icons.Material.Outlined.ViewList" /></span>
                <span class="step-number">02</span>
                <h3>@Localizer["Home_StepTwoTitle"]</h3>
                <p>@Localizer["Home_StepTwoDescription"]</p>
            </article>
            <article class="feature-card">
                <span class="feature-icon feature-icon-purple"><MudIcon Icon="@Icons.Material.Outlined.Description" /></span>
                <span class="step-number">03</span>
                <h3>@Localizer["Home_StepThreeTitle"]</h3>
                <p>@Localizer["Home_StepThreeDescription"]</p>
            </article>
        </div>
    </section>
}

@code {
    private RLSEntryPoint? _entryPoint;
    private Func<string>? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _entryPoint = await Api.GetFromJsonAsync<RLSEntryPoint>("/");
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            _error = () => Localizer["Error_ApiUnreachable", ex.Message];
        }
    }
}
