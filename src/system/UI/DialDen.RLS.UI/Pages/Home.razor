@page "/"

<PageTitle>Overview | Resume Life Simplifier</PageTitle>

@inject HttpClient Api

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" role="alert">@_error</MudAlert>
}
else if (_entryPoint is null)
{
    <div class="state-panel" role="status">
        <MudProgressCircular Indeterminate Size="Size.Small" Color="Color.Primary" />
        <p>Loading your workspace...</p>
    </div>
}
else
{
    <div class="page-heading">
        <div>
            <p class="eyebrow">YOUR NEXT CHAPTER</p>
            <h1>Overview</h1>
            <p class="page-description">A clear space to organize your job opportunities.</p>
        </div>
        <span class="page-tag">Personal workspace</span>
    </div>

    <section class="welcome-panel" aria-labelledby="welcome-title">
        <div class="welcome-copy">
            <span class="hero-label">LESS CLUTTER. MORE CLARITY.</span>
            <h2 id="welcome-title">Your next opportunity<br />starts with a little order.</h2>
            <p>Keep job postings together, find the details you need, and focus on what comes next.</p>
            <ul class="hero-actions" aria-label="Available actions">
                @foreach (var link in _entryPoint.Links.Where(link => link is { Rel: "list-postings", Method: "GET" }))
                {
                    <li>
                        <a class="action-link action-primary" href="/postings" rel="@link.Rel">
                            View postings
                            <MudIcon Icon="@Icons.Material.Outlined.ArrowForward" />
                        </a>
                    </li>
                }
            </ul>
        </div>
        <div class="welcome-art" aria-hidden="true">
            <div class="art-orbit"></div>
            <div class="art-card art-card-back"></div>
            <div class="art-card art-card-front">
                <span class="art-icon"><MudIcon Icon="@Icons.Material.Outlined.WorkOutline" Size="Size.Large" /></span>
                <span class="art-line art-line-long"></span>
                <span class="art-line"></span>
                <span class="art-check"><MudIcon Icon="@Icons.Material.Outlined.Check" /></span>
            </div>
            <span class="art-spark"><MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" /></span>
        </div>
    </section>

    <section class="getting-started" aria-labelledby="getting-started-title">
        <div class="section-heading">
            <h2 id="getting-started-title">A simpler way to stay organized</h2>
            <p>One workspace. A clearer picture.</p>
        </div>
        <div class="feature-grid">
            <article class="feature-card">
                <span class="feature-icon"><MudIcon Icon="@Icons.Material.Outlined.LibraryAdd" /></span>
                <span class="step-number">01</span>
                <h3>Capture an opportunity</h3>
                <p>Create a posting with a recognizable title so it's easy to find again.</p>
            </article>
            <article class="feature-card">
                <span class="feature-icon feature-icon-blue"><MudIcon Icon="@Icons.Material.Outlined.ViewList" /></span>
                <span class="step-number">02</span>
                <h3>Keep everything together</h3>
                <p>Browse your postings in one place instead of losing track of opportunities.</p>
            </article>
            <article class="feature-card">
                <span class="feature-icon feature-icon-purple"><MudIcon Icon="@Icons.Material.Outlined.Description" /></span>
                <span class="step-number">03</span>
                <h3>Return to the details</h3>
                <p>Open any posting to review its information whenever you need it.</p>
            </article>
        </div>
    </section>
}

@code {
    private RLSEntryPoint? _entryPoint;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _entryPoint = await Api.GetFromJsonAsync<RLSEntryPoint>("/");
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            _error = $"Could not reach the RLS API: {ex.Message}";
        }
    }
}
