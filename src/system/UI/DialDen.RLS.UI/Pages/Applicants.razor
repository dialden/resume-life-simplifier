@page "/postings/{Id:int}/applicants"
@inherits DialDen.RLS.UI.Language.LocalizedComponentBase
@using System.Globalization
@using System.Net
@using DialDen.RLS.Abstractions.Postings
@using DialDen.RLS.Abstractions.Applications
@using DialDen.RLS.UI.Notifications
@using Microsoft.Extensions.Logging
@implements IAsyncDisposable
@inject HttpClient Api
@inject NotificationService Notifications
@inject IStringLocalizer<Messages> Localizer
@inject ILogger<Applicants> Logger

<PageTitle>@Localizer["Applicants_PageTitle", _posting?.Title ?? Localizer["Navigation_JobPostings"]]</PageTitle>

<div class="breadcrumb">
    <a href="/postings">@Localizer["Navigation_JobPostings"]</a><span aria-hidden="true">/</span>
    <a href="@PostingAddress">@Localizer["Posting_Details"]</a><span aria-hidden="true">/</span>
    <span>@Localizer["Applicants_Title"]</span>
</div>
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" role="alert">@_error()</MudAlert>
}
else if (_posting is null || _applications is null)
{
    <div class="state-panel" role="status">
        <MudProgressCircular Indeterminate Size="Size.Small" Color="Color.Primary" />
        <p>@Localizer["Applications_Loading"]</p>
    </div>
}
else
{
    @if (_liveUpdatesUnavailable)
    {
        <MudAlert Severity="Severity.Warning" role="status">@Localizer["LiveUpdates_Unavailable"]</MudAlert>
    }
    <div class="page-heading">
        <div>
            <p class="eyebrow">@Localizer["Applicants_Title"]</p>
            <h1>@_posting.Title</h1>
            <p class="page-description">@Localizer["Applicants_Description"]</p>
        </div>
        <MudButton Href="@PostingAddress" Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.ArrowBack">@Localizer["Applicants_BackToPosting"]</MudButton>
    </div>
    <section class="surface-panel" aria-labelledby="applicants-heading">
        <div class="panel-header">
            <div class="panel-title">
                <h2 id="applicants-heading">@Localizer["Applicants_Title"]</h2>
                <span class="count-badge">@_applications.Count</span>
            </div>
            <span class="panel-caption">@Localizer["Postings_Reference", Id]</span>
        </div>
        <div data-testid="applications">
            @if (_applications.Count == 0)
            {
                <div class="empty-state" role="status">
                    <span class="empty-icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.PeopleOutline" Size="Size.Large" /></span>
                    <h3>@Localizer["Applications_Empty"]</h3>
                    <p>@Localizer["Applicants_EmptyHelp"]</p>
                </div>
            }
            @foreach (var application in _applications)
            {
                <article class="applicant-card" data-application-id="@application.Id">
                    <div class="applicant-heading">
                        <span class="posting-icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.PersonOutline" /></span>
                        <h3 data-testid="application-name">@application.Name</h3>
                    </div>
                    <dl class="applicant-fields">
                        <div>
                            <dt>@Localizer["Application_Email"]</dt>
                            <dd data-testid="application-email">@application.Email</dd>
                        </div>
                        <div>
                            <dt>@Localizer["Applications_Source"]</dt>
                            <dd data-testid="application-source">@(application.Source == "Client website" ? Localizer["Applications_SourceClientWebsite"] : application.Source)</dd>
                        </div>
                        @if (application.ReferralJobSiteId is not null)
                        {
                            <div>
                                <dt>@Localizer["Applications_Referral"]</dt>
                                <dd data-testid="application-referral">@application.ReferralJobSiteId</dd>
                            </div>
                        }
                    </dl>
                    <a class="action-link applicant-download" data-testid="download-resume"
                       href="@ResumeAddress(application.Id)" download>
                        <MudIcon Icon="@Icons.Material.Outlined.FileDownload" />@Localizer["Applications_Download"]
                    </a>
                    <section class="applicant-extraction" aria-labelledby="@($"extraction-heading-{application.Id}")">
                        <h4 id="@($"extraction-heading-{application.Id}")">@Localizer["Applications_ResumeInformation"]</h4>
                        <div class="applicant-extraction-status" role="status">
                            @if (application.ExtractionStatus == InformationExtractionStatus.Pending)
                            {
                                <span aria-hidden="true"><MudProgressCircular Indeterminate Size="Size.Small" Color="Color.Primary" /></span>
                            }
                            <span data-testid="application-extraction-status">@ExtractionStatusText(application.ExtractionStatus)</span>
                        </div>
                        @if (application.ExtractionStatus == InformationExtractionStatus.Failed)
                        {
                            <p class="applicant-extraction-empty">@Localizer["Applications_ExtractionFailedHelp"]</p>
                        }
                        @if (application.ExtractionStatus == InformationExtractionStatus.Completed
                            && application.ExtractedContacts is { } contacts)
                        {
                            <dl class="applicant-fields applicant-extracted-fields" data-testid="application-extracted-contacts">
                                @if (contacts.Name is not null)
                                {
                                    <div>
                                        <dt>@Localizer["Application_Name"]</dt>
                                        <dd data-testid="extracted-name">@contacts.Name</dd>
                                    </div>
                                }
                                @if (contacts.Email is not null)
                                {
                                    <div>
                                        <dt>@Localizer["Application_Email"]</dt>
                                        <dd data-testid="extracted-email">@contacts.Email</dd>
                                    </div>
                                }
                                @if (contacts.PhoneNumber is not null)
                                {
                                    <div>
                                        <dt>@Localizer["Applications_ExtractedPhoneNumber"]</dt>
                                        <dd data-testid="extracted-phone-number">@contacts.PhoneNumber</dd>
                                    </div>
                                }
                                @if (contacts.PostalAddress is not null)
                                {
                                    <div>
                                        <dt>@Localizer["Applications_ExtractedPostalAddress"]</dt>
                                        <dd data-testid="extracted-postal-address">@contacts.PostalAddress</dd>
                                    </div>
                                }
                                @if (contacts.LinkedInUrl is not null)
                                {
                                    <div>
                                        <dt>@Localizer["Applications_ExtractedLinkedInUrl"]</dt>
                                        <dd data-testid="extracted-linkedin-url">@contacts.LinkedInUrl</dd>
                                    </div>
                                }
                            </dl>
                            @if (contacts is { Name: null, Email: null, PhoneNumber: null, PostalAddress: null, LinkedInUrl: null })
                            {
                                <p class="applicant-extraction-empty">@Localizer["Applications_NoExtractedContacts"]</p>
                            }
                        }
                    </section>
                </article>
            }
        </div>
    </section>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private ViewPostingResponse? _posting;
    private IReadOnlyList<ApplicationResponse>? _applications;
    private Link? _resumeLink;
    private Func<string>? _error;
    private CancellationTokenSource? _pageCancellation;
    private Task? _observation;
    private bool _liveUpdatesUnavailable;

    private string PostingAddress => $"/postings/{Id.ToString(CultureInfo.InvariantCulture)}";

    protected override async Task OnParametersSetAsync()
    {
        await StopObserving();
        _pageCancellation = new CancellationTokenSource();
        var token = _pageCancellation.Token;
        _posting = null;
        _applications = null;
        _resumeLink = null;
        _error = null;
        _liveUpdatesUnavailable = false;
        try
        {
            var entryPoint = await Api.GetFromJsonAsync<RLSEntryPoint>("/", token)
                ?? throw new System.Text.Json.JsonException("The API returned no entry point.");
            var postingLink = entryPoint.Links.SingleOrDefault(link => link is { Rel: "view-posting", Method: "GET" });
            var applicationsLink = entryPoint.Links.SingleOrDefault(link => link is { Rel: "list-applications", Method: "GET" });
            var resumeLink = entryPoint.Links.SingleOrDefault(link => link is { Rel: "download-resume", Method: "GET" });
            if (postingLink is null || applicationsLink is null || resumeLink is null)
            {
                _error = () => Localizer["Applications_LoadError"];
                return;
            }
            var postingHref = postingLink.Href.Replace("{id}", Id.ToString(CultureInfo.InvariantCulture));
            using var response = await Api.GetAsync(postingHref, token);
            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                _error = () => Localizer["Error_PostingNotFound"];
                return;
            }
            response.EnsureSuccessStatusCode();
            var posting = await response.Content.ReadFromJsonAsync<ViewPostingResponse>(ApiJsonSerializerOptions.Default, token)
                ?? throw new System.Text.Json.JsonException("The API returned no posting.");
            var applicationsHref = applicationsLink.Href.Replace("{id}", Id.ToString(CultureInfo.InvariantCulture));
            var applications = await Api.GetFromJsonAsync<ApplicationResponse[]>(applicationsHref, ApiJsonSerializerOptions.Default, token)
                ?? throw new System.Text.Json.JsonException("The API returned no applications.");
            token.ThrowIfCancellationRequested();
            _posting = posting;
            _applications = applications;
            _resumeLink = resumeLink;
            _observation = Observe(applicationsHref, token);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // Navigation cancels requests for the previous posting.
        }
        catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException)
        {
            if (!token.IsCancellationRequested)
            {
                Logger.LogWarning(exception, "Could not load applicants for posting {PostingId}.", Id);
                _error = () => Localizer["Applications_LoadError"];
            }
        }
    }

    private async Task Observe(string applicationsHref, CancellationToken token)
    {
        using var subscription = Notifications.Subscribe();
        try
        {
            await foreach (var signal in subscription.Signals.ReadAllAsync(token))
            {
                if (signal == NotificationSignal.Unavailable)
                {
                    await InvokeAsync(() =>
                    {
                        if (!token.IsCancellationRequested)
                        {
                            _liveUpdatesUnavailable = true;
                            StateHasChanged();
                        }
                    });
                    continue;
                }

                var applications = await Api.GetFromJsonAsync<ApplicationResponse[]>(
                    applicationsHref, ApiJsonSerializerOptions.Default, token)
                    ?? throw new System.Text.Json.JsonException("The API returned no applications.");
                await InvokeAsync(() =>
                {
                    if (!token.IsCancellationRequested)
                    {
                        _applications = applications;
                        _liveUpdatesUnavailable = false;
                        StateHasChanged();
                    }
                });
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // Navigation or disposal ends the observation.
        }
        catch (Exception exception) when (exception is HttpRequestException or IOException
            or System.Text.Json.JsonException or InvalidOperationException or OperationCanceledException)
        {
            Logger.LogWarning(exception, "Live applicant updates stopped.");
            await InvokeAsync(() =>
            {
                if (!token.IsCancellationRequested)
                {
                    _liveUpdatesUnavailable = true;
                    StateHasChanged();
                }
            });
        }
        catch (Exception exception)
        {
            await DispatchExceptionAsync(exception);
        }
    }

    private async Task StopObserving()
    {
        var cancellation = _pageCancellation;
        var observation = _observation;
        _pageCancellation = null;
        _observation = null;
        if (cancellation is null)
            return;

        cancellation.Cancel();
        try
        {
            if (observation is not null)
                await observation;
        }
        finally
        {
            cancellation.Dispose();
        }
    }

    private string ResumeAddress(int applicationId)
    {
        var link = _resumeLink ?? throw new InvalidOperationException("The résumé action was not loaded.");
        var href = link.Href.Replace("{id}", Id.ToString(CultureInfo.InvariantCulture))
            .Replace("{applicationId}", applicationId.ToString(CultureInfo.InvariantCulture));
        var baseAddress = Api.BaseAddress ?? throw new InvalidOperationException("The API address is not configured.");
        return new Uri(baseAddress, href).AbsoluteUri;
    }

    private string ExtractionStatusText(InformationExtractionStatus status) => status switch
    {
        InformationExtractionStatus.Pending => Localizer["Applications_ExtractionPending"],
        InformationExtractionStatus.Completed => Localizer["Applications_ExtractionCompleted"],
        InformationExtractionStatus.Failed => Localizer["Applications_ExtractionFailed"],
        InformationExtractionStatus.NotProcessed => Localizer["Applications_ExtractionNotProcessed"],
        _ => throw new InvalidOperationException($"Unknown information extraction status: {status}.")
    };

    public async ValueTask DisposeAsync()
    {
        Dispose();
        await StopObserving();
    }
}
