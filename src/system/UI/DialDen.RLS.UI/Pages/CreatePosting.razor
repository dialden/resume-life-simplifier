@page "/postings/create"
@using DialDen.RLS.Abstractions.Postings
@inject HttpClient Api
@inject NavigationManager Navigation

<PageTitle>@L["CreatePosting_Title"] | Resume Life Simplifier</PageTitle>

<div class="breadcrumb"><a href="/postings">@L["Nav_ViewPostings"]</a><span aria-hidden="true">/</span><span>@L["CreatePosting_Title"]</span></div>
<div class="page-heading">
    <div>
        <p class="eyebrow">@L["CreatePosting_Eyebrow"]</p>
        <h1>@L["CreatePosting_Title"]</h1>
        <p class="page-description">@L["CreatePosting_Description"]</p>
    </div>
</div>

@if (_loadError is not null)
{
    <MudAlert Severity="Severity.Error" role="alert">@_loadError</MudAlert>
}
else if (_createLink is null)
{
    <div class="state-panel" role="status">
        <MudProgressCircular Indeterminate Size="Size.Small" Color="Color.Primary" />
        <p>@L["CreatePosting_Preparing"]</p>
    </div>
}
else
{
    <div class="editor-grid">
        <section class="surface-panel" aria-labelledby="posting-information">
            <div class="panel-header">
                <div>
                    <h2 id="posting-information">@L["CreatePosting_InformationTitle"]</h2>
                    <p class="panel-description">@L["CreatePosting_InformationText"]</p>
                </div>
                <MudIcon Icon="@Icons.Material.Outlined.WorkOutline" Color="Color.Primary" />
            </div>
            <form @onsubmit="Submit" @onsubmit:preventDefault>
                <div class="form-body">
                    <MudTextField T="string" Label="@L["Common_Title"]" InputId="posting-title-input"
                                  Variant="Variant.Outlined" HelperText="@L["CreatePosting_TitleHelp"]"
                                  @bind-Value="_title" Disabled="_isCreating" />
                    <MudTextField T="string" Label="@L["Common_Description"]" InputId="posting-description-input"
                                  Variant="Variant.Outlined" Lines="6" HelperText="@L["CreatePosting_DescriptionHelp"]"
                                  @bind-Value="_description" Disabled="_isCreating" />
                    @if (_creationError is not null)
                    {
                        <MudAlert Class="mt-4" Severity="Severity.Error" role="alert">@_creationError</MudAlert>
                    }
                </div>
                <div class="form-actions">
                    <MudButton Href="/postings" Variant="Variant.Text" Disabled="_isCreating">@L["Common_Cancel"]</MudButton>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" data-testid="create-posting-submit"
                               Color="Color.Primary" Disabled="_isCreating" StartIcon="@Icons.Material.Outlined.Add">
                        @(_isCreating ? L["CreatePosting_Creating"] : L["CreatePosting_Title"])
                    </MudButton>
                </div>
            </form>
        </section>
        <aside class="help-panel" aria-labelledby="help-title">
            <span class="feature-icon"><MudIcon Icon="@Icons.Material.Outlined.Lightbulb" /></span>
            <h2 id="help-title">@L["CreatePosting_HelpTitle"]</h2>
            <p>@L["CreatePosting_HelpText1"]</p>
            <div class="help-divider"></div>
            <p>@L["CreatePosting_HelpText2"]</p>
        </aside>
    </div>
}

@code {
    private Link? _createLink;
    private string? _loadError;
    private string _title = string.Empty;
    private string _description = string.Empty;
    private bool _isCreating;
    private string? _creationError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var entryPoint = await Api.GetFromJsonAsync<RLSEntryPoint>("/")
                ?? throw new System.Text.Json.JsonException(L["Api_NoEntryPoint"].Value);
            _createLink = entryPoint.Links.SingleOrDefault(
                link => link is { Rel: "create-posting", Method: "POST" });
            if (_createLink is null)
            {
                _loadError = L["CreatePosting_NotOffered"].Value;
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            _loadError = L["CreatePosting_LoadFailed", ex.Message].Value;
        }
    }

    private async Task Submit()
    {
        if (_isCreating)
        {
            return;
        }

        var link = _createLink
            ?? throw new InvalidOperationException("The posting creation action has not been loaded.");
        _isCreating = true;
        _creationError = null;

        try
        {
            using var response = await Api.PostAsJsonAsync(link.Href, new CreatePostingRequest(_title, _description));
            if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                var problem = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                _creationError = string.Join(" ", problem.GetProperty("errors").EnumerateObject()
                    .SelectMany(error => error.Value.EnumerateArray())
                    .Select(error => error.GetString()));
                return;
            }
            response.EnsureSuccessStatusCode();
            _ = await response.Content.ReadFromJsonAsync<CreatePostingResponse>(
                ApiJsonSerializerOptions.Default)
                ?? throw new System.Text.Json.JsonException(L["Api_NoCreatedPosting"].Value);
            Navigation.NavigateTo("/postings");
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            _creationError = L["CreatePosting_CreateFailed", ex.Message].Value;
        }
        finally
        {
            _isCreating = false;
        }
    }
}
