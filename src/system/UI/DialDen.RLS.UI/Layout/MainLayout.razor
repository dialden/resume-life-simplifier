@inherits LayoutComponentBase

@implements IAsyncDisposable
@inject DialDen.RLS.UI.Notifications.NotificationService Notifications
@inject DialDen.RLS.UI.Language.LanguageState Language
@inject IStringLocalizer<Messages> Localizer

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="workspace-shell">
    <a class="skip-link" href="#main-content">@Localizer["Accessibility_SkipToContent"]</a>
    <aside class="workspace-sidebar" aria-label="@Localizer["Accessibility_Workspace"]">
        <a class="brand" href="/" aria-label="@Localizer["Accessibility_Home"]">
            <span class="brand-mark" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Outlined.WorkOutline" />
            </span>
            <span class="brand-name">Resume Life<span>Simplifier</span></span>
        </a>

        <div class="nav-caption">@Localizer["Navigation_Workspace"]</div>
        <nav class="workspace-nav" aria-label="@Localizer["Accessibility_MainNavigation"]">
            <NavLink href="/" Match="NavLinkMatch.All" class="workspace-nav-link">
                <MudIcon Icon="@Icons.Material.Outlined.SpaceDashboard" />
                <span>@Localizer["Navigation_Overview"]</span>
            </NavLink>
            <NavLink href="/postings" class="workspace-nav-link">
                <MudIcon Icon="@Icons.Material.Outlined.WorkOutline" />
                <span>@Localizer["Navigation_JobPostings"]</span>
            </NavLink>
        </nav>

        <div class="sidebar-note">
            <MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" />
            <p>@Localizer["Layout_SidebarNoteFirstLine"]<br />@Localizer["Layout_SidebarNoteSecondLine"]</p>
        </div>
        <div class="sidebar-footer">Resume Life Simplifier</div>
    </aside>

    <div class="workspace-main">
        <header class="workspace-topbar">
            <span class="topbar-title">@Localizer["WorkspaceTitle"]</span>
            <div class="language-switcher" role="group" aria-label="@Localizer["Accessibility_Language"]">
                <MudButton data-testid="language-fr"
                           Variant="@(Language.Current.TwoLetterISOLanguageName == "fr" ? Variant.Filled : Variant.Text)"
                           Color="Color.Primary" Size="Size.Small"
                           OnClick="@(() => Language.ChangeAsync("fr"))"
                           aria-label="@Localizer["Language_SelectFrench"]">FR</MudButton>
                <MudButton data-testid="language-en"
                           Variant="@(Language.Current.TwoLetterISOLanguageName == "en" ? Variant.Filled : Variant.Text)"
                           Color="Color.Primary" Size="Size.Small"
                           OnClick="@(() => Language.ChangeAsync("en"))"
                           aria-label="@Localizer["Language_SelectEnglish"]">EN</MudButton>
            </div>
            <span class="workspace-label">
                <span class="workspace-dot" aria-hidden="true"></span>
                @Localizer["Layout_PersonalWorkspace"]
            </span>
        </header>
        <main id="main-content" class="workspace-content" tabindex="-1">
            @Body
        </main>
        <footer class="workspace-footer">@Localizer["Layout_Footer"]</footer>
    </div>
</div>

@code {
    private readonly CancellationTokenSource _notificationsCancellation = new();
    private Task? _notifications;

    protected override void OnInitialized()
    {
        Language.LanguageChanged += OnLanguageChanged;
        _notifications = ObserveNotifications();
    }

    private void OnLanguageChanged()
    {
        _ = InvokeAsync(() =>
        {
            DialDen.RLS.UI.Language.LanguageState.Apply(Language.Current);
            StateHasChanged();
        });
    }

    private async Task ObserveNotifications()
    {
        try
        {
            await Notifications.RunAsync(_notificationsCancellation.Token);
        }
        catch (Exception exception)
        {
            await DispatchExceptionAsync(exception);
        }
    }

    public async ValueTask DisposeAsync()
    {
        Language.LanguageChanged -= OnLanguageChanged;
        _notificationsCancellation.Cancel();
        try
        {
            if (_notifications is not null)
            {
                await _notifications;
            }
        }
        finally
        {
            _notificationsCancellation.Dispose();
        }
    }

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#0f766e",
            Secondary = "#152b43",
            Background = "#f4f6fa",
            Surface = "#ffffff",
            TextPrimary = "#182b43",
            TextSecondary = "#5d6b7e",
            AppbarBackground = "#ffffff"
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "10px"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["Inter", "Segoe UI", "Arial", "sans-serif"]
            }
        }
    };
}
