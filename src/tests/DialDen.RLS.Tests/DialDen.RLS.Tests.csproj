<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>DialDen.RLS.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageReference Include="Microsoft.Playwright.Xunit" Version="1.63.0" />
    <PackageReference Include="Shouldly" Version="4.2.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="Xunit.Combinatorial" Version="1.6.24" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../system/API/DialDen.RLS.API.Root/DialDen.RLS.API.Root.csproj" />
    <!-- Built before the tests, but not referenced: the UI is only served as static assets -->
    <ProjectReference Include="../../system/UI/DialDen.RLS.UI.Root/DialDen.RLS.UI.Root.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Exposes the UI build output folder to the tests so it is never hardcoded -->
  <Target Name="AddUIBuildPathMetadata" BeforeTargets="GetAssemblyAttributes" DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <_UIRootAssembly Include="@(_ResolvedProjectReferencePaths)"
                       Condition="'%(Filename)' == 'DialDen.RLS.UI.Root'" />
    </ItemGroup>
    <PropertyGroup>
      <_UIBuildPath>@(_UIRootAssembly->'%(RootDir)%(Directory)')</_UIBuildPath>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>UIBuildPath</_Parameter1>
        <_Parameter2>$(_UIBuildPath)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>